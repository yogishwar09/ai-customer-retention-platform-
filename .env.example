# Copy to .env and adjust. Never commit .env.
# Where models, the SQLite database and reports are written
RETENTIONIQ_ARTIFACTS_DIR=./artifacts
RETENTIONIQ_DB_PATH=./artifacts/retentioniq.db
RETENTIONIQ_REPORTS_DIR=./reports
# Optional: require X-API-Key on /v1 endpoints (leave empty for local dev)
RETENTIONIQ_API_KEY=
